# 复制为 .env 后填入自己的值；.env 已被 .gitignore 忽略，不会提交。
# 本文件只放占位符，不要写入真实 Token。

# ---- 以下供 Python 应用读取（app.py、.vscode/launch.json 的 envFile）----

# 工作区根地址：不带末尾斜杠，也不带 /?o=...
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net

# 个人访问令牌：Developer -> Access tokens 生成，scopes 勾选 sql
# 留空则启动检查会报“尚未提供 Databricks Token”，可改用“提示输入”那份调试配置
DATABRICKS_TOKEN=

# 培训数据位置，按讲师实际分配填写
DATABRICKS_CATALOG=dev_databricks
DATABRICKS_SCHEMA=default

# ---- 以下只供 .vscode/mcp.json 使用，Python 进程不读这一项 ----
# 只填域名：mcp.json 的 url 必须以字面 https:// 开头，完整地址放进变量会触发
# “URL 必须以 http:// 或 https:// 开头”的提示。
# 注意 VS Code 不会读取 .env 里的这一项，必须在启动 VS Code 的终端里设置：
#   $env:DATABRICKS_HOSTNAME = 'your-workspace.azuredatabricks.net'
DATABRICKS_HOSTNAME=your-workspace.azuredatabricks.net
