{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "dbxHost",
      "type": "promptString",
      "description": "Databricks 工作区地址（https://...，不带末尾斜杠）"
    },
    {
      "id": "dbxToken",
      "type": "promptString",
      "description": "Databricks Token（不回显，仅本次进程使用）",
      "password": true
    }
  ],
  "configurations": [
    {
      // F5 固定使用当前项目 .venv；继承 VS Code 的环境变量，.env 中同名值优先。
      // 使用用户环境变量时，不要在 .env 留空 Token 或示例 Host。
      "name": "异常跟进：启动网页（.env 或用户环境变量，8769）",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/app.py",
      "args": ["--port", "8769"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // --check 查询异常并合并已有本机记录，不调用待实现的保存方法。
      "name": "异常跟进：检查数据（.env 或用户环境变量，--check）",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/app.py",
      "args": ["--check"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // 兜底：没有 .env，或想临时连别的工作区时用；会提示输入 Host 和 Token。
      "name": "异常跟进：启动网页（提示输入 Host + Token）",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/app.py",
      "args": ["--port", "8769"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "justMyCode": true,
      "env": {
        "DATABRICKS_HOST": "${input:dbxHost}",
        "DATABRICKS_TOKEN": "${input:dbxToken}",
        "DATABRICKS_CATALOG": "dev_databricks",
        "DATABRICKS_SCHEMA": "default"
      }
    }
  ]
}
